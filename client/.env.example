# ---------------------------------------------------------------------------
# z-expense-guard client — environment template
#
# Copy to `.env` and fill in real values:
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored and must never be committed. dotenv is a convenience
# only: exporting these variables in your shell works exactly the same, and
# process environment always wins over the file.
# ---------------------------------------------------------------------------

# --- credentials ------------------------------------------------------------
# Three credentials, but only two of them are keys: the agent's is an opaque
# bearer token. The delegator and the tenant are the same account in this
# deployment, which is why one DID appears twice — a DID is per account, not
# per key, so a second key buys no isolation.

# Tenant key: registers the contract, creates the four KV maps, seeds the policy.
TENANT_API_KEY=<tenant-private-key-0x...>

# The tenant's DID — also the `pii_did` below, i.e. the identity whose grant
# authorises the contract's outbound calls.
TENANT_DID=<did:t3n:...>

# Agent bearer token (`t3n_key_<id>.<secret>`), printed exactly once by
# `t3n agent create`. This is the agent's only credential: an org agent invokes
# with it in the `X-T3N-Api-Key` header and never signs a session handshake.
AGENT_INVOKE_KEY=<t3n_key_...>

# Same token's id half. Used for log lines, never as a secret.
AGENT_KEY_ID=<t3n_key_...>

AGENT_DID=<did:t3n:...>

# Organisation the agent belongs to; minted by `t3n org create`.
ORG_DID=<did:t3n:...>

# The identity a delegated call acts FOR. Egress is authorised per call from this
# identity's grant: omit it and the call is a self call, the agent holds no grant
# of its own, and every outbound call fails with
#
#   host/http.egress_denied: egress host(s) [...] not in the resolved allowlist []
#
# even though the grant is stored correctly and reads back intact. See
# docs/BUGLOG.md BUG-14 — this costs hours if you meet it without the reason.
PII_DID=<did:t3n:...>

# Optional: set only when the data owner is a *different* account from the
# tenant. A second key for the same account returns the same DID and adds no
# isolation. `npm run delegate` signs with TENANT_API_KEY when this is unset.
# USER_API_KEY=<user-private-key-0x...>

# Optional: an org agent normally holds no Ethereum key. Set this only if yours
# does and you intend to open a session as the agent.
# AGENT_API_KEY=<agent-private-key-0x...>

# --- target cluster ---------------------------------------------------------

# One of: testnet | production
T3N_ENVIRONMENT=testnet

# --- contract ---------------------------------------------------------------

# Registration tail; the canonical contract id becomes z:<tid>:<CONTRACT_TAIL>.
CONTRACT_TAIL=expense-guard

# Published version. Must be a plain MAJOR.MINOR.PATCH semver string, and must
# increase on every re-registration of the same tail.
CONTRACT_VERSION=0.1.0

# --- contract runtime configuration -----------------------------------------

# Approval webhook the contract POSTs to from `request-approval`. The URL's
# hostname is also added to the delegation grant's allowed_hosts. Optional for
# the register/maps steps, required for `npm run delegate` and `npm run demo`.
APPROVAL_WEBHOOK_URL=https://postman-echo.com/post

# Base currency for FX normalisation; also the policy's base_currency.
# Defaults to USD when unset.
FX_BASE_CURRENCY=USD

# --- optional ---------------------------------------------------------------

# Org-data scopes attached to the delegation grant, as a JSON array of
# WireScope objects ({"path": "...", "access": ["read"|"write"|"delete"]}).
#
# z-expense-guard keeps all of its state in tenant-scoped KV maps and reads no
# org-data scopes, so the least-privilege default is the empty list. Set this
# only if you later extend the contract to read org data.
# DELEGATION_SCOPES=[]
